# Основание форматирования.
#
# ⚠ Без этого файла `end_of_line` берётся из платформы: репозиторий хранит LF
# (`.gitattributes` — `* text=auto eol=lf`), а `dotnet format` на Windows требует CRLF, и
# проверка `dotnet format --verify-no-changes` красная на машине разработчика и зелёная в
# Linux — то есть говорит о платформе, а не о коде.
#
# Стилевых правил здесь намеренно нет: набор правил, введённый разом на готовый код, означал
# бы сотни правок в одном коммите и ни одной проверенной. Исключение — лишние `using` (IDE0005):
# их правки проверяет сам компилятор.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.md]
# Markdown значащими пробелами в конце строки задаёт перенос — срезать их нельзя.
trim_trailing_whitespace = false

[*.{cs,csx}]
indent_size = 4
dotnet_diagnostic.IDE0005.severity = warning

# Миграции генерирует `dotnet ef` — руками их не правят, стилевые правила к ним не относятся.
# Прежний набор хоста, набор проекта и набор модуля Key Manager.
[{EmailSslSender.Api/Migrations,EmailSslSender.Api/Schema/Migrations,EmailSslSender.Modules.KeyManager/Schema/Migrations}/*.cs]
generated_code = true

[*.{csproj,props,targets,slnx}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{ts,tsx,css,html}]
indent_size = 2
