<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit v3 собирает тестовый проект в исполняемый файл; без этого он не запустится -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      Запускать тесты новой тестовой платформой, а не внутренним раннером xunit. Без него
      `dotnet test` видит приложение, но не понимает его протокола и отвечает «запущено
      ноль тестов» — при том что прямой запуск .exe показывает все тесты.
    -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmailSslSender.Shared\EmailSslSender.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
