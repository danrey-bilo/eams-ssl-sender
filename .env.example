# Скопируйте в .env рядом с docker-compose.yml и заполните. Файл .env в git не попадает.

# Cloudflare Tunnel. Токен — Zero Trust → Networks → Tunnels → (ваш туннель) → Install connector:
# длинная строка после `--token`. COMPOSE_PROFILES=tunnel включает службу cloudflared при обычном
# `docker compose up -d`. Без туннеля — закомментируйте обе строки.
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Свой обратный прокси вместо туннеля или вместе с ним: адрес, с которого он приходит в контейнер.
# SENDER_TRUSTED_PROXY_NETWORKS=172.18.0.1/32

# Подсеть сети туннеля, если 172.31.250.0/28 на сервере уже занята.
# SENDER_TUNNEL_SUBNET=172.31.250.0/28
