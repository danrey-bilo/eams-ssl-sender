<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit v3 собирает тестовый проект в исполняемый файл; без этого он не запустится -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!--
      Запускать тесты новой тестовой платформой, а не внутренним раннером xunit. Без этого
      `dotnet test` видит приложение, но не понимает его протокол и отвечает «запущено ноль
      тестов» — при том что прямой запуск .exe показывает все тесты.
    -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <!--
      Настоящий PostgreSQL на прогон: половина того, что проверяет модуль, — ограничения
      СХЕМЫ (этап 16.3): уникальность имени, частичный индекс личных значений, каскад при
      удалении человека. На подделке они не проверяются вовсе.
    -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmailSslSender.Modules.Settings\EmailSslSender.Modules.Settings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
