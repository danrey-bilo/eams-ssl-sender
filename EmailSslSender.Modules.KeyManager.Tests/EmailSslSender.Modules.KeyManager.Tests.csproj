<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit v3 собирает тестовый проект в исполняемый файл; без этого он не запустится -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Запускать новой тестовой платформой: иначе `dotnet test` отвечает «запущено ноль тестов» -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <!--
      Настоящий PostgreSQL на прогон: блокировка строки подписки (`FOR UPDATE SKIP LOCKED`),
      `ON CONFLICT` снимка и `text[]` на подделке не проверяются вовсе.
    -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmailSslSender.Modules.KeyManager\EmailSslSender.Modules.KeyManager.csproj" />
    <!-- Конверт и связка мастер-ключа — настоящие, из крипты модулей EAMS. -->
    <ProjectReference Include="..\modules\crypto\src\Modules.Crypto\Modules.Crypto.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
