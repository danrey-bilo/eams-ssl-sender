<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Даёт библиотеке типы ASP.NET (контроллеры, DI), не делая её веб-приложением -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Свои тесты видят внутренности модуля, чужие — нет. Общий тестовый проект на все
      модули означал бы одну сборку с доступом к нутру всех сразу, а тесты — это как раз
      то место, где срезают углы (правило 1 RULES.md).
    -->
    <InternalsVisibleTo Include="EmailSslSender.Modules.Tokens.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- ToTable, HasDatabaseName, HasFilter живут в реляционном пакете -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Единственная ссылка. Правило 1: модуль разговаривает с соседями через контракты
      EmailSslSender.Shared, а связывает их хост. Ссылка на соседний модуль ставится одной галочкой и
      по коду потом не видна нигде, кроме этого файла, — поэтому сторож смотрит именно сюда.
    -->
    <ProjectReference Include="..\EmailSslSender.Shared\EmailSslSender.Shared.csproj" />
  </ItemGroup>

</Project>
