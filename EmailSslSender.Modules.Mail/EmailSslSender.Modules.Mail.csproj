<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Даёт библиотеке типы ASP.NET (контроллеры, DI), не делая её веб-приложением -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Свои тесты видят внутренности модуля, чужие — нет. Общий тестовый проект на все
      модули означал бы одну сборку с доступом к нутру всех сразу, а тесты — это как раз
      то место, где срезают углы (правило 1 RULES.md).
    -->
    <InternalsVisibleTo Include="EmailSslSender.Modules.Mail.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- ToTable, HasDatabaseName, HasFilter живут в реляционном пакете, а не в ядре -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!--
      Отправка почты. ⚠ SmtpClient из System.Net.Mail объявлен устаревшим для нового кода,
      и MailKit — то, на что указывает сама документация Microsoft.
    -->
    <PackageReference Include="MailKit" />
    <!--
      ⚠ Ссылки на Npgsql здесь НЕТ и быть не должно (решение 0023 §1: провайдер позволен
      одному модулю хранилищ, и то по названной причине).
    -->
  </ItemGroup>

  <ItemGroup>
    <!-- ⚠ Единственная ссылка на проект, и другой здесь быть не может (правило 1). -->
    <ProjectReference Include="..\EmailSslSender.Shared\EmailSslSender.Shared.csproj" />
  </ItemGroup>

</Project>
