<Project>

  <!-- Версии пакетов — только здесь; без масок `*`. Обновляя — сверять SPDX с nuget.org. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Журнал -->
  <ItemGroup>
    <!-- Apache-2.0: структурные логи -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Apache-2.0: компактный JSON в stdout -->
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <!-- Apache-2.0: вывод в консоль -->
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <!-- База -->
  <ItemGroup>
    <!-- PostgreSQL: провайдер EF -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- MIT: конфигурации сущностей в модулях -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <!-- MIT: закреплён, иначе Npgsql тянет вторую версию -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <!-- MIT: `dotnet ef`, только хосту -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
  </ItemGroup>

  <!-- Пароли и почта -->
  <ItemGroup>
    <!-- MIT: argon2id паролей, в BCL нет -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <!-- MIT: SMTP вместо устаревшего SmtpClient -->
    <PackageVersion Include="MailKit" Version="4.18.1" />
    <!-- MIT: транзитивный от MailKit, закреплён из-за GHSA-846f-f764-76mx -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- Контракт наружу -->
  <ItemGroup>
    <!-- MIT: документ OpenAPI -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>

  <!-- Тесты -->
  <ItemGroup>
    <!-- Apache-2.0: xunit v3 на MTP, проекту нужен OutputType Exe -->
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <!-- Apache-2.0: запуск из IDE -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <!-- BSD-3-Clause: утверждения (FluentAssertions стал платным) -->
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!-- MIT: WebApplicationFactory -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- MIT: PostgreSQL в контейнере -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
  </ItemGroup>

  <!-- Модули EAMS из modules/: их версии берутся отсюда -->
  <ItemGroup>
    <!-- MIT: module-crypto -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <!-- PostgreSQL: module-hosting, замок одного экземпляра -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- Apache-2.0: module-hosting, приёмник логов -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <!-- MIT: только для сборки module-hosting, Redis не используется -->
    <PackageVersion Include="StackExchange.Redis" Version="3.1.31" />
  </ItemGroup>

  <!-- Не брать AutoMapper и FluentAssertions: платная лицензия. -->

</Project>
