<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Даёт библиотеке типы ASP.NET (контроллеры, DI), не делая её веб-приложением -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Свои тесты видят внутренности модуля, чужие — нет. Общий тестовый проект на все
      модули означал бы одну сборку с доступом к нутру всех сразу.
    -->
    <InternalsVisibleTo Include="EmailSslSender.Modules.Identity.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- ToTable, HasDatabaseName, HasFilter, FromSqlRaw живут в реляционном пакете -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <!-- Argon2id паролей — только у модуля личностей: потребитель один. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <ProjectReference Include="..\EmailSslSender.Shared\EmailSslSender.Shared.csproj" />
  </ItemGroup>

</Project>
