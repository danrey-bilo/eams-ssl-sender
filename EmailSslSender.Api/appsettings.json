{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "RateLimits": {
    "LoginPerMinute": 10,
    "LoginPerAddressPerMinute": 100,
    "ActivationPerMinute": 20,
    "AddressFactor": 10
  },
  "AllowedHosts": "*"
}
