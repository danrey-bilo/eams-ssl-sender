<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>EmailSslSender.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Только для `dotnet ef migrations add`: в выпуск не уезжает. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ⚠ Модули EAMS — подмодулями `modules/<имя>`, каждый на закреплённой метке (README, раздел
      «Модули»). Хост знает, какие модули подключены, но не знает, что внутри: связывает контракты.
    -->
    <ProjectReference Include="..\modules\core\src\Modules.Core\Modules.Core.csproj" />
    <ProjectReference Include="..\modules\crypto\src\Modules.Crypto\Modules.Crypto.csproj" />
    <ProjectReference Include="..\modules\hosting\src\Modules.Hosting\Modules.Hosting.csproj" />
    <ProjectReference Include="..\modules\identity\src\Modules.Identity\Modules.Identity.csproj" />
    <ProjectReference Include="..\modules\tokens\src\Modules.Tokens\Modules.Tokens.csproj" />
    <ProjectReference Include="..\modules\settings\src\Modules.Settings\Modules.Settings.csproj" />
    <ProjectReference Include="..\modules\mail\src\Modules.Mail\Modules.Mail.csproj" />
    <ProjectReference Include="..\EmailSslSender.Modules.KeyManager\EmailSslSender.Modules.KeyManager.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Свои интеграционные тесты видят нутро хоста — ровно так же, как тесты модуля видят
      нутро своего модуля. Промежуточные слои конвейера публичными от этого становиться не
      должны: публичный тип хоста нельзя объяснить ничем, кроме удобства теста.
    -->
    <InternalsVisibleTo Include="EmailSslSender.IntegrationTests" />
    <!-- Тестам модуля Key Manager нужна сборка схемы хоста: прежние миграции и мост к модулям. -->
    <InternalsVisibleTo Include="EmailSslSender.Modules.KeyManager.Tests" />
  </ItemGroup>

</Project>
